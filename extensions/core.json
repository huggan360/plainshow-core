{
    "id": "core",
    "name": "Dashboard",
    "description": "Your PlainShow home: widgets, account and administration.",
    "icon": "bx-grid-alt",
    "url": "https://plainshow.se",
    "api": "https://plainshow.se/api/core/v1",
    "system": true,
    "sort": 0,
    "default_access": [
        "admin",
        "moderator",
        "member",
        "guest"
    ],
    "capabilities": [
        {
            "name": "core.dashboard.use",
            "label": "Use the dashboard"
        },
        {
            "name": "core.system.view",
            "label": "See server health details"
        },
        {
            "name": "core.users.manage",
            "label": "Create and edit accounts"
        },
        {
            "name": "core.extensions.manage",
            "label": "Turn services on and off"
        },
        {
            "name": "core.permissions.manage",
            "label": "Change roles and permissions"
        },
        {
            "name": "core.updates.apply",
            "label": "Install updates"
        },
        {
            "name": "core.audit.view",
            "label": "Read the audit log"
        },
        {
            "name": "core.api.use",
            "label": "Use the API and make API tokens"
        },
        {
            "name": "core.design.tokens",
            "label": "See the design tokens"
        }
    ],
    "widgets": [
        {
            "id": "greeting",
            "title": "Welcome",
            "icon": "bx-sun",
            "sizes": [
                "l",
                "xl",
                "full"
            ],
            "default": "xl",
            "description": "Date, greeting and your account at a glance.",
            "settings": [
                {
                    "name": "display",
                    "type": "select",
                    "label": "Show",
                    "options": [
                        {
                            "value": "greeting",
                            "label": "Greeting"
                        },
                        {
                            "value": "clock",
                            "label": "Clock"
                        },
                        {
                            "value": "both",
                            "label": "Greeting and clock"
                        }
                    ],
                    "default": "greeting"
                },
                {
                    "name": "date",
                    "type": "toggle",
                    "label": "Date",
                    "default": true
                },
                {
                    "name": "seconds",
                    "type": "toggle",
                    "label": "Seconds on the clock",
                    "default": false
                },
                {
                    "name": "role",
                    "type": "toggle",
                    "label": "Role and services",
                    "default": false
                }
            ],
            "height": "short"
        },
        {
            "id": "pi-health",
            "title": "Server",
            "icon": "bx-chip",
            "sizes": [
                "m",
                "l"
            ],
            "default": "m",
            "description": "Processor, memory, storage and temperature of the Pi.",
            "settings": [
                {
                    "name": "metrics",
                    "type": "choices",
                    "label": "Bars",
                    "options": [
                        {
                            "value": "memory",
                            "label": "Memory"
                        },
                        {
                            "value": "disk",
                            "label": "Storage"
                        },
                        {
                            "value": "cpu",
                            "label": "Processor"
                        },
                        {
                            "value": "temperature",
                            "label": "Temperature"
                        }
                    ],
                    "default": [
                        "memory",
                        "disk",
                        "cpu"
                    ]
                },
                {
                    "name": "details",
                    "type": "toggle",
                    "label": "Uptime and load",
                    "default": true
                }
            ],
            "height": "normal"
        },
        {
            "id": "launcher",
            "title": "Services",
            "icon": "bx-grid-alt",
            "sizes": [
                "m",
                "l",
                "xl",
                "full"
            ],
            "default": "l",
            "description": "Open every service you can use.",
            "settings": [
                {
                    "name": "descriptions",
                    "type": "toggle",
                    "label": "Descriptions",
                    "default": false
                },
                {
                    "name": "hidden",
                    "type": "choices",
                    "label": "Hide",
                    "options": [
                        {
                            "value": "blog",
                            "label": "Blog"
                        },
                        {
                            "value": "split",
                            "label": "Split"
                        },
                        {
                            "value": "latex",
                            "label": "LaTeX"
                        },
                        {
                            "value": "web",
                            "label": "Web"
                        },
                        {
                            "value": "cloud",
                            "label": "Cloud"
                        }
                    ],
                    "default": []
                }
            ],
            "height": "short"
        },
        {
            "id": "activity",
            "title": "Recent activity",
            "icon": "bx-history",
            "sizes": [
                "m",
                "l"
            ],
            "default": "m",
            "description": "Your latest sign-ins and account changes.",
            "settings": [
                {
                    "name": "count",
                    "type": "select",
                    "label": "Rows",
                    "options": [
                        {
                            "value": "3",
                            "label": "3"
                        },
                        {
                            "value": "5",
                            "label": "5"
                        },
                        {
                            "value": "8",
                            "label": "8"
                        }
                    ],
                    "default": "5"
                }
            ],
            "height": "normal"
        },
        {
            "id": "admin-users",
            "title": "Accounts",
            "icon": "bx-group",
            "sizes": [
                "m",
                "l"
            ],
            "default": "m",
            "capability": "core.users.manage",
            "description": "Accounts, roles and two-factor coverage.",
            "settings": [
                {
                    "name": "count",
                    "type": "select",
                    "label": "Rows",
                    "options": [
                        {
                            "value": "3",
                            "label": "3"
                        },
                        {
                            "value": "5",
                            "label": "5"
                        },
                        {
                            "value": "8",
                            "label": "8"
                        }
                    ],
                    "default": "3"
                }
            ],
            "height": "normal"
        },
        {
            "id": "admin-services",
            "title": "Service health",
            "icon": "bx-pulse",
            "sizes": [
                "m",
                "l"
            ],
            "default": "m",
            "capability": "core.extensions.manage",
            "description": "Whether each service answers, and how fast.",
            "settings": [
                {
                    "name": "problems",
                    "type": "toggle",
                    "label": "Only services with problems",
                    "default": false
                }
            ],
            "height": "normal"
        },
        {
            "id": "admin-security",
            "title": "Sign-in activity",
            "icon": "bx-shield-quarter",
            "sizes": [
                "m",
                "l"
            ],
            "default": "m",
            "capability": "core.audit.view",
            "description": "Sign-ins, failures and lockouts today.",
            "settings": [
                {
                    "name": "count",
                    "type": "select",
                    "label": "Rows",
                    "options": [
                        {
                            "value": "3",
                            "label": "3"
                        },
                        {
                            "value": "5",
                            "label": "5"
                        },
                        {
                            "value": "8",
                            "label": "8"
                        }
                    ],
                    "default": "3"
                }
            ],
            "height": "normal"
        },
        {
            "id": "admin-updates",
            "title": "Updates",
            "icon": "bx-refresh",
            "description": "New versions waiting to be installed.",
            "sizes": [
                "s",
                "m",
                "l"
            ],
            "default": "m",
            "capability": "core.updates.apply",
            "settings": [],
            "height": "normal"
        },
        {
            "id": "notes",
            "title": "Notes",
            "icon": "bx-note",
            "description": "A note to yourself, kept on your dashboard.",
            "sizes": [
                "s",
                "m",
                "l"
            ],
            "default": "m",
            "settings": [
                {
                    "name": "text",
                    "type": "text",
                    "label": "Note",
                    "max": 2000
                }
            ],
            "height": "normal"
        },
        {
            "id": "bookmarks",
            "title": "Bookmarks",
            "icon": "bx-bookmark",
            "description": "Links you open often.",
            "sizes": [
                "s",
                "m",
                "l"
            ],
            "default": "m",
            "settings": [
                {
                    "name": "links",
                    "type": "links",
                    "label": "Links"
                }
            ],
            "height": "normal"
        }
    ],
    "version": "1.0.0"
}
