{
    "id": "core",
    "name": "Dashboard",
    "description": "Your PlainShow home: widgets, account and administration.",
    "icon": "bx-grid-alt",
    "url": "https://plainshow.se",
    "api": "https://plainshow.se/api/core/v1",
    "system": true,
    "sort": 0,
    "default_access": [
        "admin",
        "moderator",
        "user",
        "guest"
    ],
    "capabilities": [
        {
            "name": "core.dashboard.use",
            "label": "Use the dashboard",
            "description": "Open the PlainShow dashboard and use the widgets available to the account.",
            "tier": "user",
            "group": "Dashboard"
        },
        {
            "name": "core.system.view",
            "label": "See server health details",
            "description": "View processor, memory, storage, temperature and service health information.",
            "tier": "moderator",
            "group": "Monitoring"
        },
        {
            "name": "core.users.manage",
            "label": "Create and edit accounts",
            "description": "Create, disable, change and remove PlainShow accounts and their service access.",
            "tier": "admin",
            "group": "Accounts"
        },
        {
            "name": "core.groups.view",
            "label": "View groups",
            "description": "Open the groups page and see groups the person belongs to and their members.",
            "tier": "user",
            "group": "Groups"
        },
        {
            "name": "core.groups.create",
            "label": "Create groups",
            "description": "Create groups, invite members and manage groups the person owns.",
            "tier": "user",
            "group": "Groups",
            "implies": [
                "core.groups.view"
            ]
        },
        {
            "name": "core.groups.manage",
            "label": "Manage every group",
            "description": "Open, change or remove any PlainShow group, including groups owned by someone else.",
            "tier": "moderator",
            "group": "Groups",
            "implies": [
                "core.groups.create",
                "core.groups.view"
            ]
        },
        {
            "name": "core.extensions.manage",
            "label": "Turn services on and off",
            "description": "Enable, disable and configure installed PlainShow services.",
            "tier": "admin",
            "group": "Platform"
        },
        {
            "name": "core.permissions.manage",
            "label": "Change roles and permissions",
            "description": "Create roles and change role or person-specific permissions across every service.",
            "tier": "admin",
            "group": "Accounts"
        },
        {
            "name": "core.updates.apply",
            "label": "Install updates",
            "description": "Review and install application updates on the production server.",
            "tier": "admin",
            "group": "Platform"
        },
        {
            "name": "core.audit.view",
            "label": "Read the audit log",
            "description": "See sign-ins, account changes and administrative activity recorded by PlainShow.",
            "tier": "moderator",
            "group": "Monitoring"
        },
        {
            "name": "core.api.use",
            "label": "Use the API",
            "description": "Create personal API tokens and use the PlainShow API with this account's permissions.",
            "tier": "user",
            "group": "Account"
        },
        {
            "name": "core.design.tokens",
            "label": "See design tokens",
            "description": "Open the design reference containing PlainShow colours, typography and components.",
            "tier": "user",
            "group": "Dashboard"
        }
    ],
    "widgets": [
        {
            "id": "greeting",
            "title": "Welcome",
            "icon": "bx-sun",
            "sizes": [
                "l",
                "xl",
                "full"
            ],
            "default": "xl",
            "description": "Date, greeting and a clock.",
            "settings": [
                {
                    "name": "display",
                    "type": "select",
                    "label": "Show",
                    "options": [
                        {
                            "value": "greeting",
                            "label": "Greeting"
                        },
                        {
                            "value": "clock",
                            "label": "Clock"
                        },
                        {
                            "value": "both",
                            "label": "Greeting and clock"
                        }
                    ],
                    "default": "greeting"
                },
                {
                    "name": "date",
                    "type": "toggle",
                    "label": "Date",
                    "default": true
                },
                {
                    "name": "seconds",
                    "type": "toggle",
                    "label": "Seconds on the clock",
                    "default": false
                },
                {
                    "name": "role",
                    "type": "toggle",
                    "label": "Role and services",
                    "default": false
                }
            ],
            "height": "short",
            "border": "orange"
        },
        {
            "id": "pi-health",
            "title": "Server",
            "icon": "bx-chip",
            "sizes": [
                "m",
                "l"
            ],
            "default": "m",
            "description": "Processor, memory, storage and temperature of the Pi.",
            "settings": [
                {
                    "name": "metrics",
                    "type": "choices",
                    "label": "Bars",
                    "options": [
                        {
                            "value": "memory",
                            "label": "Memory"
                        },
                        {
                            "value": "disk",
                            "label": "Storage"
                        },
                        {
                            "value": "cpu",
                            "label": "Processor"
                        },
                        {
                            "value": "temperature",
                            "label": "Temperature"
                        }
                    ],
                    "default": [
                        "memory",
                        "disk",
                        "cpu"
                    ]
                },
                {
                    "name": "details",
                    "type": "toggle",
                    "label": "Uptime and load",
                    "default": true
                }
            ],
            "height": "normal"
        },
        {
            "id": "news",
            "title": "News",
            "icon": "bx-news",
            "sizes": [
                "m",
                "l",
                "xl"
            ],
            "default": "m",
            "height": "normal",
            "description": "The latest headlines from your news sources.",
            "settings": [
                {
                    "name": "pictures",
                    "type": "toggle",
                    "label": "Pictures",
                    "default": true
                }
            ]
        },
        {
            "id": "weather",
            "title": "Weather",
            "icon": "bx-cloud-light-rain",
            "sizes": [
                "s",
                "m",
                "l"
            ],
            "default": "m",
            "height": "normal",
            "description": "The weather where you are, under a sky that follows the time of day.",
            "settings": [
                {
                    "name": "place",
                    "type": "place",
                    "label": "Place"
                }
            ]
        },
        {
            "id": "forecast",
            "title": "Forecast",
            "icon": "bx-cloud",
            "sizes": [
                "l",
                "xl",
                "full"
            ],
            "default": "l",
            "height": "normal",
            "description": "The weather now, the coming hours and the week ahead.",
            "settings": [
                {
                    "name": "place",
                    "type": "place",
                    "label": "Place"
                }
            ]
        },
        {
            "id": "radar",
            "title": "Rain radar",
            "icon": "bx-radar",
            "sizes": [
                "m",
                "l",
                "xl"
            ],
            "default": "m",
            "height": "normal",
            "description": "Rain on the map around you, the last two hours.",
            "settings": [
                {
                    "name": "place",
                    "type": "place",
                    "label": "Place"
                },
                {
                    "name": "area",
                    "type": "select",
                    "label": "Area",
                    "options": [
                        {
                            "value": "near",
                            "label": "Near"
                        },
                        {
                            "value": "region",
                            "label": "Region"
                        },
                        {
                            "value": "wide",
                            "label": "Wide"
                        }
                    ],
                    "default": "region"
                }
            ]
        },
        {
            "id": "launcher",
            "title": "Services",
            "icon": "bx-grid-alt",
            "sizes": [
                "m",
                "l",
                "xl",
                "full"
            ],
            "default": "l",
            "description": "Open every service you can use.",
            "settings": [
                {
                    "name": "descriptions",
                    "type": "toggle",
                    "label": "Descriptions",
                    "default": false
                },
                {
                    "name": "hidden",
                    "type": "choices",
                    "label": "Hide",
                    "options": [
                        {
                            "value": "blog",
                            "label": "Blog"
                        },
                        {
                            "value": "split",
                            "label": "Split"
                        },
                        {
                            "value": "latex",
                            "label": "LaTeX"
                        },
                        {
                            "value": "web",
                            "label": "Web"
                        },
                        {
                            "value": "cloud",
                            "label": "Cloud"
                        }
                    ],
                    "default": []
                }
            ],
            "height": "short"
        },
        {
            "id": "activity",
            "title": "Recent activity",
            "icon": "bx-history",
            "sizes": [
                "m",
                "l"
            ],
            "default": "m",
            "description": "Your latest sign-ins and account changes.",
            "settings": [],
            "height": "normal"
        },
        {
            "id": "admin-users",
            "title": "Accounts",
            "icon": "bx-group",
            "sizes": [
                "m",
                "l"
            ],
            "default": "m",
            "capability": "core.users.manage",
            "description": "Accounts, roles and two-factor coverage.",
            "settings": [],
            "height": "normal"
        },
        {
            "id": "admin-services",
            "title": "Service health",
            "icon": "bx-pulse",
            "sizes": [
                "m",
                "l"
            ],
            "default": "m",
            "capability": "core.extensions.manage",
            "description": "Whether each service answers, and how fast.",
            "settings": [
                {
                    "name": "problems",
                    "type": "toggle",
                    "label": "Only services with problems",
                    "default": false
                }
            ],
            "height": "normal"
        },
        {
            "id": "admin-security",
            "title": "Sign-in activity",
            "icon": "bx-shield-quarter",
            "sizes": [
                "m",
                "l"
            ],
            "default": "m",
            "capability": "core.audit.view",
            "description": "Sign-ins, failures and lockouts today.",
            "settings": [],
            "height": "normal"
        },
        {
            "id": "admin-updates",
            "title": "Updates",
            "icon": "bx-refresh",
            "description": "New versions waiting to be installed.",
            "sizes": [
                "s",
                "m",
                "l"
            ],
            "default": "m",
            "capability": "core.updates.apply",
            "settings": [],
            "height": "normal"
        },
        {
            "id": "notes",
            "title": "Notes",
            "icon": "bx-note",
            "description": "A note to yourself, kept on your dashboard.",
            "sizes": [
                "s",
                "m",
                "l"
            ],
            "default": "m",
            "settings": [
                {
                    "name": "text",
                    "type": "text",
                    "label": "Note",
                    "max": 2000
                }
            ],
            "height": "normal"
        },
        {
            "id": "bookmarks",
            "title": "Bookmarks",
            "icon": "bx-bookmark",
            "description": "Links you open often.",
            "sizes": [
                "s",
                "m",
                "l"
            ],
            "default": "m",
            "settings": [
                {
                    "name": "links",
                    "type": "links",
                    "label": "Links"
                }
            ],
            "height": "normal"
        }
    ],
    "version": "1.0.0"
}
